# Cấu hình chạy phần mềm QY4-TTBYT
PORT=5000

# Chế độ an toàn production mặc định: KHÔNG tự tạo dữ liệu demo, KHÔNG reset seed.
# Chỉ đặt true khi chạy bộ dữ liệu demo riêng biệt.
DEMO_MODE=false

# BẮT BUỘC nếu muốn QR mở được bằng điện thoại qua Internet/4G/5G,
# không cần cùng mạng với máy tính.
# Điền domain/tunnel public trỏ tới máy chủ đang chạy phần mềm.
# Ví dụ: https://ttbyt-qy4.example.vn hoặc https://abc.trycloudflare.com
QR_PUBLIC_BASE_URL=https://ttbyt-qy4.example.vn

# Có thể dùng PUBLIC_BASE_URL thay cho QR_PUBLIC_BASE_URL nếu muốn.
# PUBLIC_BASE_URL=https://ttbyt-qy4.example.vn
