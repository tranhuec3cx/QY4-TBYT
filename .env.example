# Cấu hình chạy phần mềm QY4-TTBYT
PORT=5000

# Chế độ an toàn production mặc định: KHÔNG tự tạo dữ liệu demo, KHÔNG reset seed.
# Chỉ đặt true khi chạy bộ dữ liệu demo riêng biệt.
DEMO_MODE=false

# XÁC THỰC / PHÂN QUYỀN
# Nên đặt mật khẩu quản trị ban đầu >= 10 ký tự trước lần chạy đầu tiên.
# Nếu để trống/chưa cấu hình, hệ thống tự sinh mật khẩu tạm thời và in MỘT LẦN trên cửa sổ chạy phần mềm.
ADMIN_INITIAL_PASSWORD=
# Thời hạn phiên đăng nhập (giờ), mặc định 8; tối đa 24.
AUTH_SESSION_HOURS=8
# Nếu chạy qua reverse proxy/domain đặc biệt có thể khai báo thêm origin, phân tách bằng dấu phẩy.
# AUTH_ALLOWED_ORIGINS=https://ttbyt-qy4.example.vn

# TRUST PROXY
# Mặc định để trống/false: máy chủ KHÔNG tin X-Forwarded-For do client tự gửi.
# Chỉ cấu hình khi phần mềm thực sự đặt sau reverse proxy/tunnel do đơn vị kiểm soát.
# Ví dụ 1 proxy hop: TRUST_PROXY=1
# Có thể dùng giá trị Express hỗ trợ như: loopback
TRUST_PROXY=false

# QR CÔNG KHAI CÓ CHỮ KÝ
# Có thể đặt một khóa bí mật >= 32 ký tự để ký mã QR. Không chia sẻ và không commit khóa thật.
# Nếu để trống, hệ thống tự sinh khóa mạnh và lưu cục bộ tại db/qr-signing-secret.
# Phải sao lưu khóa này cùng DB: nếu mất/đổi khóa, các nhãn QR cũ sẽ không còn hợp lệ và cần in lại.
QR_SIGNING_SECRET=

# BẮT BUỘC nếu muốn QR mở được bằng điện thoại qua Internet/4G/5G,
# không cần cùng mạng với máy tính.
# Điền domain/tunnel public trỏ tới máy chủ đang chạy phần mềm.
# Ví dụ: https://ttbyt-qy4.example.vn hoặc https://abc.trycloudflare.com
QR_PUBLIC_BASE_URL=https://ttbyt-qy4.example.vn

# Có thể dùng PUBLIC_BASE_URL thay cho QR_PUBLIC_BASE_URL nếu muốn.
# PUBLIC_BASE_URL=https://ttbyt-qy4.example.vn
